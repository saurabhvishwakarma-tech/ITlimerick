# Copy to .env for docker compose. Never commit the real .env.
DATABASE_PASSWORD=change-me
# Emails that become platform admins when they register (comma-separated).
APP_ADMIN_EMAILS=you@example.com
# The address people open the app at. With a tunnel, put the https link here (see docs/TESTING-WITH-FRIENDS.md).
APP_PUBLIC_BASE_URL=http://localhost:8080
# true only when everyone (you included) opens the app through an https link.
COOKIE_SECURE=false
# true = fill an empty database with a fictional sample event (for demos only).
APP_SEED_DEMO_DATA=true
# A date like 2027-02-18, or "today" to see the "On now" marker in action.
APP_SEED_DEMO_DATE=today

# Google / LinkedIn login. Leave empty to hide the buttons. Setup: docs/SOCIAL-LOGIN.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Testing only: print password-reset emails (with the link) in the API logs. Keep false for the real event.
EMAIL_LOG_CONTENT=false
